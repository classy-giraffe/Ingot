#!/bin/sh
# Main image build script (chroot variant: runs inside the image root
# merged with the build overlay, so the build toolchain installed as
# build packages (cargo, gcc) is available. / is writable via the
# volatile build overlay; writes to it are discarded after the script,
# so build byproducts (source tree, cargo target/) stay out of the image
# payload.
#
# Builds the Rust components from source staged by the prepare
# script (final phase) at /work/artifacts/: brush (pinned upstream,
# the runtime root's /bin/sh) and nushell (pinned upstream, the
# interactive admin shell), plus the in-repo workspace's
# ingot-update-helper, and installs them into the image via $DESTDIR:
# mkosi copies $DESTDIR into the image root after the build scripts
# ("Copying in build tree"), which is the only way build-script output
# reaches the final payload.
set -eu

# The /usr/bin/pkg-config wrapper shells out to rpm (absent from the
# slot image); use the platform-specific wrapper, which only execs
# pkgconf.
export PKG_CONFIG=/usr/bin/x86_64-redhat-linux-gnu-pkg-config
# nettle-sys (sequoia-openpgp build dep) would otherwise generate its
# bindings with bindgen (needs libclang, absent from the slot image);
# the committed pregenerated bindings (from the pinned nettle3.10-devel
# headers) are used instead.
# selinux-sys (uutils' chcon/runcon) generates its bindings with
# bindgen, which drives libclang. libclang locates its builtin
# headers (stddef.h & co) in a "resource dir" derived from the
# library's load location; rawhide's clang-libs layout (libclang in
# /usr/lib64, builtin headers in /usr/lib/clang/<major>/include via
# clang-resource-filesystem) does not satisfy that lookup, so the
# parse dies with "stddef.h file not found". Pin the resource dir
# explicitly (bindgen appends these to every clang invocation).
CLANG_RESOURCE_DIR=
for d in /usr/lib/clang/*/include; do
    [ -f "$d/stddef.h" ] || continue
    CLANG_RESOURCE_DIR=${d%/include}
    break
done
[ -n "$CLANG_RESOURCE_DIR" ] \
    || { echo "build: libclang resource dir (clang-resource-filesystem) not found" >&2; exit 1; }
export BINDGEN_EXTRA_CLANG_ARGS="-resource-dir $CLANG_RESOURCE_DIR"
export NETTLE_PREGENERATED_BINDINGS=/usr/src/ingot/update-helper/build/nettle-bindings.rs
: "${BRUSH_SHA:?BRUSH_SHA must be set (image/mkosi.conf)}"
[ -d /work/artifacts/brush-source ] \
    || { echo "build: brush source missing at /work/artifacts/brush-source" >&2; exit 1; }

# Unpack at a fixed path inside the chroot (writable via the volatile
# overlay). The fixed path keeps the build deterministic: no
# workspace-specific paths end up in the binary.
rm -rf /usr/src/brush
cp -a /work/artifacts/brush-source /usr/src/brush

# The cargo registry (index + crate sources) was primed by the prepare
# script (build phase, which runs with network) at
# /work/artifacts/cargo-home with the image's own toolchain. Build
# offline against it: pinned compose + pinned source + pinned crate
# versions (Cargo.lock, --locked --offline).
CARGO_HOME=/work/artifacts/cargo-home
HOME=/
export CARGO_HOME HOME
cargo build --release --locked --offline \
    --manifest-path /usr/src/brush/Cargo.toml --bin brush

install -D -m 0755 /usr/src/brush/target/release/brush "$DESTDIR/usr/bin/brush"
# brush is /bin/sh on the runtime root (usr-merged /bin -> usr/bin)
ln -sf brush "$DESTDIR/usr/bin/sh"

# --- nushell: the interactive admin shell (spec 3.1). Same discipline
# as brush: pinned upstream source, primed registry, offline --locked
# build, installed via $DESTDIR.
: "${NUSHELL_SHA:?NUSHELL_SHA must be set (image/mkosi.conf)}"
[ -d /work/artifacts/nushell-source ] \
    || { echo "build: nushell source missing at /work/artifacts/nushell-source" >&2; exit 1; }
rm -rf /usr/src/nushell
cp -a /work/artifacts/nushell-source /usr/src/nushell
cargo build --release --locked --offline \
    --manifest-path /usr/src/nushell/Cargo.toml --bin nu
install -D -m 0755 /usr/src/nushell/target/release/nu "$DESTDIR/usr/bin/nu"
# the interactive shell's canonical name (the installer's default
# user shell references /usr/bin/nushell)
ln -sf nu "$DESTDIR/usr/bin/nushell"
echo "ingot: nushell ${NUSHELL_SHA} built and staged to /usr/bin/nu (+ /usr/bin/nushell)" >&2

# --- helix: the terminal editor (spec 7.2). Same discipline as
# brush/nushell: pinned upstream source, primed registry, offline
# --locked build, installed via $DESTDIR. The build script
# (helix-term/build.rs) fetches and compiles the tree-sitter grammars
# pinned in the source's languages.toml: the prepare phase pre-staged
# the grammar repositories at the exact remote + revision, so the
# fetch is a no-op here (the loader reports them up to date) and the
# compilation runs offline against the chroot's gcc.
: "${HELIX_SHA:?HELIX_SHA must be set (image/mkosi.conf)}"
[ -d /work/artifacts/helix-source ] \
    || { echo "build: helix source missing at /work/artifacts/helix-source" >&2; exit 1; }
rm -rf /usr/src/helix
cp -a /work/artifacts/helix-source /usr/src/helix
# The runtime lookup directory baked into the binary at build time
# (helix's downstream-packager hook): the runtime files (queries,
# themes, the compiled grammar libraries) install to /usr/share/helix.
export HELIX_DEFAULT_RUNTIME=/usr/share/helix
cargo build --release --locked --offline \
    --manifest-path /usr/src/helix/Cargo.toml --bin hx
install -D -m 0755 /usr/src/helix/target/release/hx "$DESTDIR/usr/bin/helix"
# the editor's canonical name plus the upstream short name (the same
# pattern as nu/nushell)
ln -sf helix "$DESTDIR/usr/bin/hx"
# The runtime tree: queries, themes, tutor, and the compiled
# tree-sitter grammar libraries (runtime/grammars/*.so, built by the
# build script above). The staged grammar source repositories are git
# checkouts - build input only, stripped before the payload copy.
rm -rf /usr/src/helix/runtime/grammars/sources
mkdir -p "$DESTDIR/usr/share/helix"
cp -a /usr/src/helix/runtime/. "$DESTDIR/usr/share/helix/"
echo "ingot: helix ${HELIX_SHA} built and staged to /usr/bin/helix (+ /usr/bin/hx, runtime at /usr/share/helix)" >&2

# --- zellij: the terminal multiplexer (spec 7.2). Same discipline:
# pinned upstream source, primed registry, offline --locked build,
# installed via $DESTDIR. The default plugins ship as pre-built wasm
# committed in the source tree (zellij-utils/assets/plugins/); a
# release build embeds them directly (no wasm toolchain needed). The
# default vendored-curl feature builds OpenSSL from source (make +
# perl in the build overlay) and links the system libcurl (runtime).
: "${ZELLIJ_SHA:?ZELLIJ_SHA must be set (image/mkosi.conf)}"
[ -d /work/artifacts/zellij-source ] \
    || { echo "build: zellij source missing at /work/artifacts/zellij-source" >&2; exit 1; }
rm -rf /usr/src/zellij
cp -a /work/artifacts/zellij-source /usr/src/zellij
cargo build --release --locked --offline \
    --manifest-path /usr/src/zellij/Cargo.toml --bin zellij
install -D -m 0755 /usr/src/zellij/target/release/zellij "$DESTDIR/usr/bin/zellij"
echo "ingot: zellij ${ZELLIJ_SHA} built and staged to /usr/bin/zellij" >&2

# --- coreutils (uutils): the core CLI utilities (spec 7.2). Same
# discipline: pinned upstream source, primed registry, offline
# --locked build, installed via $DESTDIR. feat_os_unix is the full
# *nix utility set; each utility is a workspace crate with its own
# binary (the root package only carries the multicall `coreutils`),
# so build the workspace's bin targets. The built binaries shadow the
# distro coreutils files in the final payload (mkosi copies $DESTDIR
# over the installed packages; the distro package stays installed
# because systemd, dracut, kernel-core and util-linux require it).
: "${COREUTILS_SHA:?COREUTILS_SHA must be set (image/mkosi.conf)}"
[ -d /work/artifacts/coreutils-source ] \
    || { echo "build: coreutils source missing at /work/artifacts/coreutils-source" >&2; exit 1; }
rm -rf /usr/src/coreutils
cp -a /work/artifacts/coreutils-source /usr/src/coreutils
cargo build --release --locked --offline --workspace --bins \
    --features feat_os_unix \
    --manifest-path /usr/src/coreutils/Cargo.toml
# Every target/release/<name> without an extension is a utility
# binary (the .d debuglink files and subdirectories are skipped).
for bin in /usr/src/coreutils/target/release/*; do
    [ -f "$bin" ] || continue
    case "$bin" in *.*) continue ;; esac
    install -D -m 0755 "$bin" "$DESTDIR/usr/bin/$(basename "$bin")"
done
echo "ingot: coreutils (uutils) ${COREUTILS_SHA} built and staged to /usr/bin/*" >&2

# --- ingot-update-helper: the in-repo Rust workspace (spec 7.1). The
# source was staged by the prepare script (final phase) at
# /work/artifacts/ingot-source; the same primed registry and the same
# offline discipline apply (Cargo.lock --locked --offline).
rm -rf /usr/src/ingot
cp -a /work/artifacts/ingot-source /usr/src/ingot
rm -rf /usr/src/ingot/target
cargo build --release --locked --offline \
    --manifest-path /usr/src/ingot/Cargo.toml --bin ingot-update-helper
install -D -m 0755 /usr/src/ingot/target/release/ingot-update-helper \
    "$DESTDIR/usr/bin/ingot-update-helper"
echo "ingot: ingot-update-helper built and staged to /usr/bin/ingot-update-helper" >&2
# --- ingot-installer: the declarative install engine (spec 7.1, 11).
# Same discipline as the update helper. It lands in the slot payload:
# the live ISO (whose rootfs IS the slot erofs) runs it unattended
# from a declarative config disk (spec 10.2.5: the ISO includes the
# installer and deployment tooling); the installed system carries it
# as well (single payload).
cargo build --release --locked --offline \
    --manifest-path /usr/src/ingot/Cargo.toml --bin ingot-installer
install -D -m 0755 /usr/src/ingot/target/release/ingot-installer \
    "$DESTDIR/usr/bin/ingot-installer"
echo "ingot: ingot-installer built and staged to /usr/bin/ingot-installer" >&2
echo "ingot: brush ${BRUSH_SHA} built and staged to /usr/bin/brush (/bin/sh)" >&2
