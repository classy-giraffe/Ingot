#!/bin/sh
# Main image build script (chroot variant: runs inside the image root
# merged with the build overlay, so the build toolchain installed as
# build packages (cargo, gcc) is available. / is writable via the
# volatile build overlay; writes to it are discarded after the script,
# so build byproducts (source tree, cargo target/) stay out of the image
# payload.
#
# Builds the Rust components from source staged by the prepare
# script (final phase) at /work/artifacts/: brush (pinned upstream,
# the runtime root's /bin/sh) and nushell (pinned upstream, the
# interactive admin shell), plus the in-repo workspace's
# ingot-update-helper, and installs them into the image via $DESTDIR:
# mkosi copies $DESTDIR into the image root after the build scripts
# ("Copying in build tree"), which is the only way build-script output
# reaches the final payload.
set -eu

# The /usr/bin/pkg-config wrapper shells out to rpm (absent from the
# slot image); use the platform-specific wrapper, which only execs
# pkgconf.
export PKG_CONFIG=/usr/bin/x86_64-redhat-linux-gnu-pkg-config
# nettle-sys (sequoia-openpgp build dep) would otherwise generate its
# bindings with bindgen (needs libclang, absent from the slot image);
# the committed pregenerated bindings (from the pinned nettle3.10-devel
# headers) are used instead.
export NETTLE_PREGENERATED_BINDINGS=/usr/src/ingot/update-helper/build/nettle-bindings.rs
: "${BRUSH_SHA:?BRUSH_SHA must be set (image/mkosi.conf)}"
[ -d /work/artifacts/brush-source ] \
    || { echo "build: brush source missing at /work/artifacts/brush-source" >&2; exit 1; }

# Unpack at a fixed path inside the chroot (writable via the volatile
# overlay). The fixed path keeps the build deterministic: no
# workspace-specific paths end up in the binary.
rm -rf /usr/src/brush
cp -a /work/artifacts/brush-source /usr/src/brush

# The cargo registry (index + crate sources) was primed by the prepare
# script (build phase, which runs with network) at
# /work/artifacts/cargo-home with the image's own toolchain. Build
# offline against it: pinned compose + pinned source + pinned crate
# versions (Cargo.lock, --locked --offline).
CARGO_HOME=/work/artifacts/cargo-home
HOME=/
export CARGO_HOME HOME
cargo build --release --locked --offline \
    --manifest-path /usr/src/brush/Cargo.toml --bin brush

install -D -m 0755 /usr/src/brush/target/release/brush "$DESTDIR/usr/bin/brush"
# brush is /bin/sh on the runtime root (usr-merged /bin -> usr/bin)
ln -sf brush "$DESTDIR/usr/bin/sh"

# --- nushell: the interactive admin shell (spec 3.1). Same discipline
# as brush: pinned upstream source, primed registry, offline --locked
# build, installed via $DESTDIR.
: "${NUSHELL_SHA:?NUSHELL_SHA must be set (image/mkosi.conf)}"
[ -d /work/artifacts/nushell-source ] \
    || { echo "build: nushell source missing at /work/artifacts/nushell-source" >&2; exit 1; }
rm -rf /usr/src/nushell
cp -a /work/artifacts/nushell-source /usr/src/nushell
cargo build --release --locked --offline \
    --manifest-path /usr/src/nushell/Cargo.toml --bin nu
install -D -m 0755 /usr/src/nushell/target/release/nu "$DESTDIR/usr/bin/nu"
# the interactive shell's canonical name (the installer's default
# user shell references /usr/bin/nushell)
ln -sf nu "$DESTDIR/usr/bin/nushell"
echo "ingot: nushell ${NUSHELL_SHA} built and staged to /usr/bin/nu (+ /usr/bin/nushell)" >&2

# --- ingot-update-helper: the in-repo Rust workspace (spec 7.1). The
# source was staged by the prepare script (final phase) at
# /work/artifacts/ingot-source; the same primed registry and the same
# offline discipline apply (Cargo.lock --locked --offline).
rm -rf /usr/src/ingot
cp -a /work/artifacts/ingot-source /usr/src/ingot
rm -rf /usr/src/ingot/target
cargo build --release --locked --offline \
    --manifest-path /usr/src/ingot/Cargo.toml --bin ingot-update-helper
install -D -m 0755 /usr/src/ingot/target/release/ingot-update-helper \
    "$DESTDIR/usr/bin/ingot-update-helper"
echo "ingot: ingot-update-helper built and staged to /usr/bin/ingot-update-helper" >&2
echo "ingot: brush ${BRUSH_SHA} built and staged to /usr/bin/brush (/bin/sh)" >&2
